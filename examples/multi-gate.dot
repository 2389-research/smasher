// ABOUTME: Pipeline with multiple sequential human approval gates before deployment.
// ABOUTME: Demonstrates chaining Manager nodes for multi-stage sign-off workflows.

// Complex workflows often require multiple approvals from different
// stakeholders before proceeding. This pipeline chains two Manager
// nodes (shape=house) in sequence, modeling a real-world approval
// process:
//
//   1. Security review — checks for vulnerabilities, secrets exposure
//   2. Compliance check — verifies regulatory and policy adherence
//
// Each gate can reject the pipeline independently. Only when both
// gates approve does the pipeline proceed to deployment.
//
// The `question` attribute on each Manager node provides context-specific
// prompts to the human reviewer at each stage.
//
// Run this pipeline:
//   smasher run examples/multi-gate.dot

digraph MultiGate {
    // Entry point
    start [shape=circle, label="Start"];

    // First gate: Security review
    security_check [
        shape=house,
        label="Security Review",
        question="Does this change pass security review? Check for secrets, injection vulnerabilities, and auth issues."
    ];

    // Second gate: Compliance check
    compliance_check [
        shape=house,
        label="Compliance Check",
        question="Does this change meet compliance requirements? Verify data handling, audit logging, and access controls."
    ];

    // Deployment step — only reached after both gates approve
    deploy [shape=box, label="Deploy", prompt="Execute the deployment procedure."];

    // Terminal nodes
    exit_deployed       [shape=doublecircle, label="Deployed"];
    exit_security_fail  [shape=doublecircle, label="Security Rejected"];
    exit_compliance_fail [shape=doublecircle, label="Compliance Rejected"];

    // Flow: start -> security gate -> compliance gate -> deploy -> done
    start -> security_check;

    // Security gate routing
    security_check -> compliance_check   [label="success"];
    security_check -> exit_security_fail [label="failure"];

    // Compliance gate routing
    compliance_check -> deploy                [label="success"];
    compliance_check -> exit_compliance_fail  [label="failure"];

    // After deployment
    deploy -> exit_deployed;
}
