// ABOUTME: Pipeline demonstrating conditional branching based on a variable.
// ABOUTME: The diamond-shaped node evaluates a condition; edges route by label.

// Conditional nodes use shape=diamond and have a `condition` attribute that
// is evaluated against the pipeline context (variables set via --var).
//
// Edge labels like "success" and "failure" route based on the outcome of
// the preceding node. For conditional nodes, "success" means the condition
// evaluated to true; "failure" means it evaluated to false.
//
// Run with different routes:
//   smasher run examples/conditional.dot --var route=yes
//   smasher run examples/conditional.dot --var route=no

digraph Conditional {
    // Entry point
    start [shape=circle, label="Start"];

    // Conditional node: evaluates "route=yes" against the context.
    // The ConditionalHandler returns success when the condition is true,
    // failure when false. Edge labels then route accordingly.
    check [shape=diamond, label="Check Route", condition="route=yes"];

    // Success path: taken when route=yes
    happy [shape=doublecircle, label="Success Exit"];

    // Failure path: taken when route != yes
    sad   [shape=doublecircle, label="Failure Exit"];

    // Wiring
    start -> check;
    check -> happy [label="success"];
    check -> sad   [label="failure"];
}
